{
  "manifest_version": 3,
  "name": "Claude RTL Chat",
  "version": "1.2.1",
  "description": "Right-to-left rendering for Persian/Arabic/Hebrew text in claude.ai chats.",
  "author": "reza bagheri (rezabagheri6)",
  "host_permissions": ["https://claude.ai/*", "https://*.claude.ai/*"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*", "https://*.claude.ai/*"],
      "js": ["claude-rtl.user.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Claude RTL",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
